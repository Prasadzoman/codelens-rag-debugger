# CodeLens Server Configuration
# Copy this file to .env and adjust values as needed

# Server port (default: 3001)
PORT=3001

# LLM Provider: 'auto' (detects Ollama), 'ollama', or 'local' (offline engine)
LLM_PROVIDER=auto

# Ollama configuration (only needed when LLM_PROVIDER=ollama or auto)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Embedding provider: 'local' (deterministic, always works), 'xenova' (ONNX Transformers.js), 'ollama'
EMBEDDING_PROVIDER=local

# Python binary path (for FAISS engine)
PYTHON_BIN=python

# Node environment
NODE_ENV=development
